// The window's and the desktop island's pages: the browser, no Node.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": [] },
  "include": ["src/renderer/**/*.js", "src/renderer/**/*.ts", "src/shared/**/*.js", "src/shared/**/*.ts"],
  // What the shell and the backend share that needs Node; the pages never load it.
  "exclude": ["src/shared/node/**"]
}
