{
  "name": "viva-source-kit",
  "version": "0.1.0",
  "description": "Tools for Viva message sources: defineSource runtime, validator CLI, and templates",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "bin": {
    "viva-source": "bin/viva-source.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin",
    "dist",
    "templates",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build-source-kit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
