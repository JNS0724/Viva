{
  "name": "demo-dsh-plugin",
  "version": "0.1.0",
  "description": "Test fixture shaped like a community dsh plugin: a bundle with one host tool and a web client part",
  "type": "module",
  "main": "tool.js",
  "exports": { ".": "./tool.js", "./package.json": "./package.json" },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.1.0", "@deepseek-ai/dsh-tools": "0.2.2-rc.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots"] }
  }
}
