{
  "name": "viva",
  "productName": "Viva",
  "version": "0.4.0-beta.7",
  "private": true,
  "description": "Viva: a personal desktop assistant powered by Electron and DeepSeek Harness (ACP)",
  "license": "MIT",
  "author": "JNS0724",
  "repository": {
    "type": "git",
    "url": "https://github.com/JNS0724/Viva.git"
  },
  "type": "module",
  "main": "out/src/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.plugins.json && tsc -p tsconfig.test.json",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test \"test/**/*.test.{js,ts}\"",
    "coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test --experimental-test-coverage \"test/**/*.test.{js,ts}\"",
    "presmoke": "npm run build",
    "smoke": "playwright test -c test/smoke/playwright.config.ts --project=smoke --project=integration",
    "smoke:core": "playwright test -c test/smoke/playwright.config.ts --project=smoke",
    "smoke:setup": "playwright test -c test/smoke/playwright.config.ts --project=integration --grep @setup",
    "smoke:walkthrough": "playwright test -c test/smoke/playwright.config.ts --project=integration --grep @walkthrough",
    "smoke:relaunch": "playwright test -c test/smoke/playwright.config.ts --project=integration --grep @relaunch",
    "smoke:memory": "playwright test -c test/smoke/playwright.config.ts --project=integration --grep @memory",
    "smoke:resume": "playwright test -c test/smoke/playwright.config.ts --project=integration --grep @resume",
    "smoke:timeline": "playwright test -c test/smoke/playwright.config.ts --project=integration --grep @timeline",
    "smoke:perf": "playwright test -c test/smoke/playwright.config.ts --project=performance",
    "smoke:package": "playwright test -c test/smoke/playwright.config.ts --project=package",
    "live:memory": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/live-memory.js",
    "prelive": "npm run build",
    "live": "node scripts/live.ts",
    "showcase": "npm run build && node scripts/showcase.ts",
    "predist:mac": "npm run build",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "predist:win": "npm run build",
    "dist:win": "electron-builder --win nsis --publish never",
    "smoke:language": "playwright test -c test/smoke/playwright.config.ts --project=integration --grep @language",
    "check:i18n": "node scripts/check-i18n.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-native-command": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.0-rc.2",
    "highlight.js": "11.11.1",
    "marked": "18.0.14",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "cross-env": "7.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "typescript": "6.0.3",
    "@electron/asar": "3.4.1"
  },
  "build": {
    "appId": "app.viva.desktop",
    "productName": "Viva",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "out/**/*",
      "!out/test/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "icon": "build/icons/viva.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/viva.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
