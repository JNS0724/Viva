{
  "name": "viva",
  "productName": "Viva",
  "version": "0.3.2-beta.1",
  "private": true,
  "description": "Viva：个人桌面助手，Electron 外壳 + DeepSeek Harness（ACP）",
  "license": "MIT",
  "author": "JNS0724",
  "repository": {
    "type": "git",
    "url": "https://github.com/JNS0724/Viva.git"
  },
  "type": "module",
  "main": "out/src/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.plugins.json",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test \"test/**/*.test.js\"",
    "coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test --experimental-test-coverage \"test/**/*.test.js\"",
    "presmoke": "npm run build",
    "smoke": "npm run smoke:setup && npm run smoke:walkthrough && npm run smoke:relaunch && npm run smoke:memory && npm run smoke:resume",
    "smoke:setup": "cross-env SMOKE_PHASE=setup DEEPSEEK_API_KEY= electron .",
    "smoke:walkthrough": "cross-env SMOKE_PHASE=walkthrough DEEPSEEK_API_KEY=smoke-fake-key DSH_BIN=test/fixtures/fake-dsh.js electron .",
    "smoke:relaunch": "cross-env SMOKE_PHASE=relaunch DEEPSEEK_API_KEY=smoke-fake-key DSH_BIN=test/fixtures/fake-dsh.js electron .",
    "smoke:memory": "cross-env SMOKE_PHASE=memory DEEPSEEK_API_KEY=smoke-fake-key SMOKE_LLM_PORT=47815 electron .",
    "smoke:resume": "cross-env SMOKE_PHASE=resume DEEPSEEK_API_KEY=smoke-fake-key SMOKE_LLM_PORT=47815 electron .",
    "live:memory": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/live-memory.js",
    "predist:mac": "npm run build",
    "dist:mac": "electron-builder --mac dmg",
    "predist:win": "npm run build",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-native-command": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.0-rc.2",
    "highlight.js": "11.11.1",
    "marked": "18.0.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "24.19.2",
    "cross-env": "7.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "app.viva.desktop",
    "productName": "Viva",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "out/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "icon": "build/icons/viva.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/viva.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
